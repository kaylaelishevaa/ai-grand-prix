# Copy to .env.local. Never use NEXT_PUBLIC_ for these variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Separate voice model for the live WebRTC call; needs access in your OpenAI project.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Rehearse online first, then set 1 and restart. Misses fail without network.
DEMO_OFFLINE=0
NEXT_TELEMETRY_DISABLED=1
